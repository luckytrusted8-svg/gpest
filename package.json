{
  "name": "gpest-root",
  "version": "1.0.0",
  "private": true,
  "description": "G-PEST Full-Stack Monorepo (Next.js + NestJS + MySQL)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"npm run start:dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "prisma:migrate": "npm run prisma:migrate --prefix backend",
    "prisma:generate": "npm run prisma:generate --prefix backend",
    "prisma:seed": "npm run prisma:seed --prefix backend",
    "prisma:studio": "npm run prisma:studio --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
