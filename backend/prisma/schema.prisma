generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  SUPERVISOR
  TECHNICIAN
  CUSTOMER
}

enum LeadStage {
  COLD
  WARM
  HOT
  WON
  LOST
}

enum TaskStatus {
  PENDING
  ASSIGNED
  EN_ROUTE
  ON_SITE
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum ContractFrequency {
  ON_CALL
  WEEKLY
  BI_WEEKLY
  MONTHLY
  BI_MONTHLY
  QUARTERLY
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALFDAY
  LEAVE
}

enum LeaveType {
  ANNUAL
  SICK
  SPECIAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

// -------------------------------------------------------------
// 1. Multi-Tenant Core
// -------------------------------------------------------------
model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  address     String?  @db.Text
  phone       String?
  email       String?
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users            User[]
  customers        Customer[]
  leads            Lead[]
  contracts        Contract[]
  tasks            Task[]
  serviceCatalogs  ServiceCatalog[]
  attendance       Attendance[]
  leaveRequests    LeaveRequest[]
  tickets          Ticket[]
  invoices         Invoice[]

  @@map("tenants")
}

// -------------------------------------------------------------
// 2. User & RBAC
// -------------------------------------------------------------
model User {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  email        String
  passwordHash String
  phone        String?
  role         Role     @default(TECHNICIAN)
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  assignedTasks Task[]          @relation("TechnicianTasks")
  attendances   Attendance[]
  leaveRequests LeaveRequest[]
  locations     LocationHistory[]
  resolvedTickets Ticket[]      @relation("AssignedTickets")

  @@unique([tenantId, email])
  @@map("users")
}

// -------------------------------------------------------------
// 3. Service Catalog & Services
// -------------------------------------------------------------
model ServiceCatalog {
  id                  String   @id @default(uuid())
  tenantId            String
  code                String   // e.g. GENERAL_PEST, TERMITE, RODENT
  name                String
  description         String?  @db.Text
  defaultWarrantyDays Int      @default(30)
  basePrice           Decimal  @default(0.00) @db.Decimal(12, 2)
  formSchemaJson      Json?    // Dynamic Form Builder Schema for this service
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contracts           Contract[]
  tasks               Task[]

  @@unique([tenantId, code])
  @@map("service_catalogs")
}

// -------------------------------------------------------------
// 4. CRM Leads
// -------------------------------------------------------------
model Lead {
  id              String    @id @default(uuid())
  tenantId        String
  leadNumber      String
  contactName     String
  companyName     String?
  phone           String
  email           String?
  address         String?   @db.Text
  city            String?
  pestIssue       String?   @db.Text
  stage           LeadStage @default(COLD)
  estimatedValue  Decimal?  @db.Decimal(12, 2)
  notes           String?   @db.Text
  convertedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("leads")
}

// -------------------------------------------------------------
// 5. Customer & Multi-site Locations
// -------------------------------------------------------------
model Customer {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  companyName String?
  email       String?
  phone       String
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locations   CustomerLocation[]
  contracts   Contract[]
  tasks       Task[]
  tickets     Ticket[]
  invoices    Invoice[]

  @@map("customers")
}

model CustomerLocation {
  id             String   @id @default(uuid())
  customerId     String
  branchName     String   // e.g. "Main Kitchen", "Warehouse Cikarang"
  address        String   @db.Text
  latitude       Float
  longitude      Float
  geofenceRadius Int      @default(100) // meters
  picName        String?
  picPhone       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contracts      Contract[]
  tasks          Task[]
  tickets        Ticket[]

  @@map("customer_locations")
}

// -------------------------------------------------------------
// 6. Contracts
// -------------------------------------------------------------
model Contract {
  id                 String            @id @default(uuid())
  tenantId           String
  customerId         String
  customerLocationId String?
  serviceCatalogId   String?
  contractNumber     String            @unique
  frequency          ContractFrequency @default(MONTHLY)
  status             ContractStatus    @default(ACTIVE)
  startDate          DateTime
  endDate            DateTime
  totalValue         Decimal           @default(0.00) @db.Decimal(12, 2)
  notes              String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerLocation   CustomerLocation? @relation(fields: [customerLocationId], references: [id])
  serviceCatalog     ServiceCatalog?   @relation(fields: [serviceCatalogId], references: [id])
  tasks              Task[]

  @@map("contracts")
}

// -------------------------------------------------------------
// 7. Tasks (Execution Engine)
// -------------------------------------------------------------
model Task {
  id                 String     @id @default(uuid())
  tenantId           String
  contractId         String?
  customerId         String
  customerLocationId String
  serviceCatalogId   String?
  technicianId       String?

  taskNumber         String
  status             TaskStatus @default(PENDING)
  scheduledDate      DateTime   @db.Date
  timeSlot           String?    // e.g. "09:00 - 11:00"
  priority           String     @default("NORMAL")
  
  departureTime      DateTime?  // When status -> EN_ROUTE
  actualStartTime    DateTime?  // When status -> ON_SITE (Check-in)
  actualEndTime      DateTime?  // When status -> COMPLETED (Check-out)
  geofenceDeviation  Int?       // in meters if check-in was outside radius
  deviationReason    String?

  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract           Contract?         @relation(fields: [contractId], references: [id])
  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerLocation   CustomerLocation  @relation(fields: [customerLocationId], references: [id])
  serviceCatalog     ServiceCatalog?   @relation(fields: [serviceCatalogId], references: [id])
  technician         User?             @relation("TechnicianTasks", fields: [technicianId], references: [id])

  workReport         WorkReport?
  locationHistories  LocationHistory[]

  @@map("tasks")
}

// -------------------------------------------------------------
// 8. Work Report & Dynamic Inspection
// -------------------------------------------------------------
model WorkReport {
  id               String   @id @default(uuid())
  taskId           String   @unique
  reportNumber     String   @unique
  
  dynamicData      Json?    // Pest found, Infestation level, areas, custom dynamic fields
  recommendations  String?  @db.Text
  
  customerPicName  String?
  signatureUrl     String?  @db.Text
  signedAt         DateTime?

  pdfUrl           String?  @db.Text
  pdfGeneratedAt   DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  task             Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  chemicalsUsed    ChemicalUsage[]
  photos           ReportPhoto[]

  @@map("work_reports")
}

model ChemicalUsage {
  id           String     @id @default(uuid())
  workReportId String
  name         String
  batchNumber  String?
  amountUsed   Float
  unit         String     // ml, gr, liter, tablet
  method       String?    // spraying, baiting, fogging, dusting

  workReport   WorkReport @relation(fields: [workReportId], references: [id], onDelete: Cascade)

  @@map("chemical_usages")
}

model ReportPhoto {
  id           String     @id @default(uuid())
  workReportId String
  photoUrl     String     @db.Text
  photoType    String     // BEFORE, AFTER, EVIDENCE
  caption      String?
  createdAt    DateTime   @default(now())

  workReport   WorkReport @relation(fields: [workReportId], references: [id], onDelete: Cascade)

  @@map("report_photos")
}

// -------------------------------------------------------------
// 9. Real-time Location Tracking & Breadcrumbs
// -------------------------------------------------------------
model LocationHistory {
  id         String   @id @default(uuid())
  userId     String
  taskId     String?
  latitude   Float
  longitude  Float
  speed      Float?
  heading    Float?
  battery    Int?
  recordedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task       Task?    @relation(fields: [taskId], references: [id])

  @@index([userId, recordedAt])
  @@map("location_histories")
}

// -------------------------------------------------------------
// 10. Attendance & HR Leave
// -------------------------------------------------------------
model Attendance {
  id           String           @id @default(uuid())
  tenantId     String
  userId       String
  clockInTime  DateTime         @default(now())
  clockOutTime DateTime?
  clockInLat   Float?
  clockInLng   Float?
  clockOutLat  Float?
  clockOutLng  Float?
  selfieUrl    String?
  status       AttendanceStatus @default(PRESENT)

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("attendances")
}

model LeaveRequest {
  id          String      @id @default(uuid())
  tenantId    String
  userId      String
  type        LeaveType   @default(ANNUAL)
  status      LeaveStatus @default(PENDING)
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  reason      String      @db.Text
  approvedBy  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}

// -------------------------------------------------------------
// 11. Ticketing & Complaints
// -------------------------------------------------------------
model Ticket {
  id                 String         @id @default(uuid())
  tenantId           String
  customerId         String
  customerLocationId String?
  assignedToUserId   String?
  ticketNumber       String         @unique
  title              String
  description        String         @db.Text
  status             TicketStatus   @default(OPEN)
  priority           TicketPriority @default(MEDIUM)
  resolutionNotes    String?        @db.Text
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerLocation   CustomerLocation? @relation(fields: [customerLocationId], references: [id])
  assignedTo         User?             @relation("AssignedTickets", fields: [assignedToUserId], references: [id])

  @@map("tickets")
}

// -------------------------------------------------------------
// 12. Invoices
// -------------------------------------------------------------
model Invoice {
  id            String    @id @default(uuid())
  tenantId      String
  customerId    String
  invoiceNumber String    @unique
  issueDate     DateTime  @default(now())
  dueDate       DateTime
  totalAmount   Decimal   @db.Decimal(12, 2)
  status        String    @default("UNPAID") // UNPAID, PAID, CANCELLED
  pdfUrl        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("invoices")
}
